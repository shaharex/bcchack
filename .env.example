# Copy to .env and set a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_ATTEMPTS=3

# Optional commit hash or tag for the report passport.
VALIDATOR_AGENT_VERSION=
# Use high, medium or low for each overridden criterion.
VALIDATOR_SEVERITY_OVERRIDES='{}'
