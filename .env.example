# Copy to .env and set a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_ATTEMPTS=3
GEMINI_MAX_RETRY_WAIT_SECONDS=60
# Comma-separated models tried in order when the main model stays unavailable (HTTP 503/504) or over quota (HTTP 429).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Optional stronger model for the executable check only (rules → executable model). The main chain is its fallback.
EXECUTABLE_GEMINI_MODEL=
# Set to 0 to skip the executable check and save 4–8 Gemini calls per run.
VALIDATOR_EXECUTABLE=1

# Optional commit hash or tag for the report passport.
VALIDATOR_AGENT_VERSION=
# Use high, medium or low for each overridden criterion.
VALIDATOR_SEVERITY_OVERRIDES='{}'
